---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary';
}

const { variant = 'primary', type = 'button', class: className, ...attributes } = Astro.props;
---

<button {...attributes} type={type} class:list={['button', `button--${variant}`, className]}>
  <span><slot /></span>
</button>

<style>
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: #f6f6f6;
    font: inherit;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms, border-color 160ms, background-color 160ms;
  }

  .button--primary {
    width: 100%;
    min-height: 49px;
    padding: 12px 16px;
    border: 1px solid #f6f6f6;
    font-size: 13px;
  }

  .button--secondary {
    width: fit-content;
    min-height: 36px;
    padding: 8px;
    color: var(--muted);
    font-size: 11px;
  }

  .button:disabled {
    cursor: default;
    border-color: #444;
    color: var(--muted);
  }

  .button:focus-visible {
    outline: 1px solid #f6f6f6;
    outline-offset: 5px;
  }

  @media (hover: hover) {
    .button:hover:not(:disabled) { color: #fff; }
    .button--primary:hover:not(:disabled) { color: #141414; background-color: #f6f6f6; }
  }
  .button--primary:active:not(:disabled) { color: #141414; background-color: #fff; }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
